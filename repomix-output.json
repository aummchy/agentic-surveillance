app.mount("/captures", StaticFiles(directory=str(CAPTURES_DIR)), name="captures")


@app.get("/")
async def root():
    return {"message": "Surveillance Dashboard API", "status": "running"}


@app.get("/health")
async def health():
    return {"status": "healthy"}
