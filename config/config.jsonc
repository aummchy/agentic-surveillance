{
  // ============================================================
  // config.jsonc — Centralized tunable parameters
  // ============================================================
  // Edit this file to change accuracy, detection, and quality settings.
  // Environment variables (.env) override these values if set.
  // Secrets (API keys, passwords) belong in .env, not here.
  // ============================================================

  // ── Face Matching ────────────────────────────────────────────
  // Cosine similarity threshold for ArcFace embeddings.
  // Higher = stricter (fewer false positives), lower = more matches (more false positives).
  // ArcFace optimal range: 0.40–0.60. Max recommended: 0.45.
  "MATCH_THRESHOLD": 0.45,
  "DEDUP_SIMILARITY_THRESHOLD": 0.4,

  // ── Model / Pipeline ─────────────────────────────────────────
  // YOLO_MODEL: PyTorch (.pt) or OpenVINO IR (_openvino_model/) path.
  // YOLO_DEVICE: Device string passed to Ultralytics model.track().
  //   PyTorch models: "cpu" or CUDA device (e.g. "0").
  //   OpenVINO IR models: must be "cpu" (accelerator set by OPENVINO_DEVICE).
  // Export:  yolo export model=models/yolov8s.pt format=openvino half=True
  "YOLO_MODEL": "models/yolov8s_openvino_model/",
  "YOLO_DEVICE": "cpu",
  "OPENVINO_DEVICE": "GPU",
  "INSIGHTFACE_MODEL": "buffalo_l",
  "INSIGHTFACE_PROVIDER": "CPUExecutionProvider",

  // ── Storage ──────────────────────────────────────────────────
  "MONGODB_DATABASE": "surveillance",
  "MONGODB_COLLECTION": "faces",
  "MONGODB_EVENTS_COLLECTION": "events",

  // ── Camera ───────────────────────────────────────────────────
  // Higher resolution = more face detail = better recognition.
  // Camera will auto-negotiate down if max not supported.
  "FRAME_WIDTH": 1920,
  "FRAME_HEIGHT": 1080,
  // CAMERA_BACKEND: OpenCV backend override, e.g. "dshow" (Windows)
  // or "msmf". Empty = auto-detect.
  "CAMERA_BACKEND": "dshow",

  // ── YOLO Detection ──────────────────────────────────────────
  // Person detection confidence threshold.
  // Lower = track more persons (good for low light), higher = fewer false detections.
  "PERSON_CONF_THRESHOLD": 0.4,
  "TRACK_TIMEOUT_SECS": 3.0,
  "MAX_TRACK_SECS": 300,

  // ── Face Detection Fallback ──────────────────────────────────
  // ENABLE_FULL_FRAME_FALLBACK: When false, skip the full-frame (1920x1080) SCRFD
  // scan that runs when crop detection fails. The crop is expanded 20% and CLAHE is
  // skipped for tiny crops to compensate. Set true only if crop detection misses too
  // many faces and the slow fallback is acceptable.
  "ENABLE_FULL_FRAME_FALLBACK": false,

  // ── ByteTrack (config/bytetrack_surveillance.yaml) ──────────
  // These are documented here for reference. Actual values live in the YAML.
  // To change them, edit config/bytetrack_surveillance.yaml directly.
  // track_high_thresh:  0.45  — first-stage match (should match PERSON_CONF_THRESHOLD)
  // track_low_thresh:   0.05  — second-stage rescue for occluded detections
  // new_track_thresh:   0.50  — min confidence to spawn a new track
  // track_buffer:       60    — frames to keep lost tracks alive (2s at 30fps)
  // match_thresh:       0.80  — IoU threshold for matching

  // ── Face Detection Scores ────────────────────────────────────
  // DET_SCORE_MIN: Standard threshold for face detection confidence.
  // DET_SCORE_RELAXED: Fafllback threshold (very permissive, use cautiously).
  // EMBEDDING_DET_SCORE_MIN: Minimum to generate an embedding from a face.
  "DET_SCORE_MIN": 0.4,
  "DET_SCORE_RELAXED": 0.2,
  "EMBEDDING_DET_SCORE_MIN": 0.4,

  // ── Progressive Recognition ──────────────────────────────────
  // Run face recognition every N frames (20 at 30fps = once per 0.67 seconds).
  "RECOGNITION_INTERVAL_FRAMES": 20,
  "INSIGHTFACE_DET_SIZE": 640,

  // ── Re-scan for Unknown Tracks ──────────────────────────────
  // For tracks with similarity > 0 but status unknown:
  // re-scan every RESCAN_INTERVAL_SECS, up to MAX_RESCAN_ATTEMPTS times.
  "RESCAN_INTERVAL_SECS": 3,
  "MAX_RESCAN_ATTEMPTS": 3,

  // ── Quality — Validity gates ──────────────────────────────────
  // BLUR_MIN: Reject faces too blurry to be usable (< 40).
  // BRIGHTNESS_MIN/MAX: Reject faces too dark (< 35) or fully saturated (> 255).
  // FACE_AREA_MIN: Minimum face area in pixels (~35x35 = 1200).
  "QUALITY_VALID_BLUR_MIN": 40,
  "QUALITY_VALID_BRIGHTNESS_MIN": 35,
  "QUALITY_VALID_BRIGHTNESS_MAX": 255,
  "QUALITY_VALID_FACE_AREA_MIN": 1200,

  // ── Quality — Scoring normalization ───────────────────────────
  // BLUR: 40=weak, 350=maxed. Weight 50%.
  // BRIGHTNESS: center-radius model (peak at 145, radius 110). Weight 25%.
  // AREA: 1500=weak, 10000=maxed. Weight 25%.
  "QUALITY_BLUR_MIN": 40,
  "QUALITY_BLUR_MAX": 350,
  "QUALITY_BRIGHTNESS_CENTER": 145,
  "QUALITY_BRIGHTNESS_RADIUS": 110,
  "QUALITY_FACE_AREA_MIN": 1500,
  "QUALITY_AREA_MAX": 10000,
  "QUALITY_WEIGHT_BLUR": 0.5,
  "QUALITY_WEIGHT_BRIGHT": 0.25,
  "QUALITY_WEIGHT_AREA": 0.25,

  // ── JPEG Compression ────────────────────────────────────────
  // STORE: Quality for stored face captures (higher = better facial detail).
  // BROADCAST: Quality for live WebSocket stream (lower = less bandwidth).
  // At 640x480, 80 is recommended — 65 makes compression blocks visibly noisy.
  "JPEG_QUALITY_STORE": 85,
  "JPEG_QUALITY_BROADCAST": 85,

  // DEBUG_FACE_CROPS: Save face crops to captures/debug/face_crops/ (for debugging model behavior)
  "DEBUG_FACE_CROPS": true,

  // REGISTRATION_QUALITY_MIN: Minimum face quality (0-1) to auto-register a new unknown identity.
  // Prevents low-quality embeddings from polluting the database and causing false matches.
  "REGISTRATION_QUALITY_MIN": 0.6,

  // ── Vector Search ────────────────────────────────────────────
  // CANDIDATES: HNSW candidate pool size (higher = better recall, slower).
  // LIMIT: Number of top results returned.
  // SCAN_LIMIT: Max documents for Python cosine fallback scan.
  "VECTOR_SEARCH_CANDIDATES": 150,
  "VECTOR_SEARCH_LIMIT": 5,
  "SCAN_LIMIT": 500,

  // ── Embedding History ────────────────────────────────────────
  // EMBEDDING_HISTORY_CAP: Max past embeddings stored per person.
  "EMBEDDING_HISTORY_CAP": 25,

  // ── Recognition Thresholds ───────────────────────────────────
  // VERY_HIGH_SIMILARITY: Definite known (0.90+ typical).
  // HIGH_CONFIDENCE: Skip re-recognition (0.85+).
  // KNOWN_VISITOR_SIMILARITY: Auto-escalate to known_visitor.
  // KNOWN_VISITOR_CONFIDENCE: Alternative confidence threshold.
  // BORDERLINE_QUALITY: Face quality threshold for borderline case.
  // MASK_CONFIDENCE_PENALTY: Multiply confidence by this for masked faces.
  "VERY_HIGH_SIMILARITY": 0.9,
  "HIGH_CONFIDENCE_SIMILARITY": 0.85,
  "KNOWN_VISITOR_SIMILARITY": 0.85,
  "KNOWN_VISITOR_CONFIDENCE": 80,
  "BORDERLINE_FACE_QUALITY": 0.8,
  "MASK_CONFIDENCE_PENALTY": 0.85,

  // ── Visit Dedup ────────────────────────────────────────────
  // MIN_VISIT_GAP_SECS: Suppress a visit if the same person was recorded
  // within this many seconds. Prevents ByteTrack fragmentation from inflating
  // visit counts (one person split into multiple overlapping track IDs).
  // Set to 0 to disable. Default 60s.
  "MIN_VISIT_GAP_SECS": 60,

  // ── CLAHE (Contrast Enhancement) ────────────────────────────
  // Applied to every frame before face detection.
  "CLAHE_CLIP_LIMIT": 2.0,
  "CLAHE_TILE_SIZE": 8,

  // ── Face Visibility ──────────────────────────────────────────
  "VISIBLE_FACE_RATIO": 0.025,
  "PARTIAL_FACE_RATIO": 0.01,
  "MIN_TRACK_FRAMES": 15,

  // ── Mask Detection ───────────────────────────────────────────
  // Geometric heuristic threshold (lower/upper face ratio).
  "MASK_RATIO_THRESHOLD": 0.3,

  // ── Office Hours (Policy Agent) ──────────────────────────────
  // Persons detected outside these hours on weekdays trigger alerts.
  // Hours are in LOCAL TIME (server timezone).
  "OFFICE_HOURS_START": 9,
  "OFFICE_HOURS_END": 17,
  "OFFICE_DAYS": [0, 1, 2, 3, 4],

  // ── Alerting ─────────────────────────────────────────────────
  "ALERT_CHANNELS": ["console", "webhook"],
  "ALERT_COOLDOWN_SECS": 60,

  // ── Loitering ────────────────────────────────────────────────
  "LOITER_SECS": 30,

  // ── Calculation Log ─────────────────────────────────────────
  // ENABLE_CALC_LOG: Write confidence formula breakdown to logs/calculation.log
  // CALC_LOG_MAX_SIZE_MB: Truncate file when it exceeds this size (MB)
  "ENABLE_CALC_LOG": true,
  "CALC_LOG_MAX_SIZE_MB": 10,

  // ── Broadcast ────────────────────────────────────────────────
  // FRAME_SKIP: Broadcast every Nth frame to the dashboard WebSocket.
  // Higher = less bandwidth, lower FPS on dashboard.
  "FRAME_SKIP": 2,

  // ── Debug Flags ──────────────────────────────────────────────
  // DEBUG_RECOGNITION: Enable diagnostic logging for recognition pipeline investigation.
  // Logs in logs/surveillance.debug.log only (not terminal).
  "DEBUG_RECOGNITION": true,
  // DEBUG_DUPLICATE_BOXES: Log per-frame detection/track state to identify multi-box issues.
  // Logs ByteTrack IDs, TrackState lifecycle, and high-IoU track pairs.
  // Enable via env var: DEBUG_DUPLICATE_BOXES=true python main.py
  "DEBUG_DUPLICATE_BOXES": true,
  // PERFORMANCE_STATS: Print per-second FPS/tracker latency line to terminal.
  // Set false after benchmarking to suppress the noise.
  "PERFORMANCE_STATS": false,

  // ── LLM (Ollama) ────────────────────────────────────────────
  "LLM_ENABLED": false,
  "OLLAMA_URL": "http://localhost:11434",
  "OLLAMA_MODEL": "gemma3:4b",
  "OLLAMA_TIMEOUT": 30,

  // ── Camera ───────────────────────────────────────────────────
  // CAMERA_SOURCE: RTSP URL string (e.g. "rtsp://192.168.1.10:554/stream")
  //   for mobile phone cameras. Empty string = use CAMERA_INDEX instead.
  "CAMERA_SOURCE": "videos/low_4.mp4",
  "CAMERA_INDEX": 0,
  "CAMERA_ID": "cam_01"
}
