# ============================================================
# .env.example — Secrets & environment-specific overrides
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to version control
#
# Tunable parameters (thresholds, model paths, devices, camera,
# database names) are in config/config.jsonc — edit that file.
# Environment variables here OVERRIDE config.jsonc values.
# ============================================================

# ── MongoDB Atlas (REQUIRED) ──────────────────────────────────
# Get from: https://cloud.mongodb.com → Database → Connect → Drivers
# Database/collection names live in config/config.jsonc
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ── Cloudinary (Optional — for cloud image storage) ───────────
# If empty, images are saved locally under captures/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Alerting (Optional) ───────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── Email (SMTP) — Optional ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ── SMS (Twilio) — Optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=

# ── Camera (Optional — overrides config.jsonc) ────────────────
# Webcam index (default 0), OR a video file / RTSP / HTTP stream:
#   CAMERA_SOURCE=D:/videos/sample.mp4
#   CAMERA_SOURCE=rtsp://192.168.1.10:554/stream
# CAMERA_INDEX=0

# ── Logging ──────────────────────────────────────────────────
# Options: console (default), json
LOG_FORMAT=console
