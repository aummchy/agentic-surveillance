# ============================================================
# .env.example — Secrets & environment-specific overrides
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to version control
#
# Tunable parameters (thresholds, model sizes, quality weights)
# are in config/config.jsonc — edit that file instead.
# Environment variables here OVERRIDE config.jsonc values.
# ============================================================

# ── MongoDB Atlas (REQUIRED) ──────────────────────────────────
# Get from: https://cloud.mongodb.com → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=surveillance
MONGODB_COLLECTION=faces
MONGODB_EVENTS_COLLECTION=events

# ── Cloudinary (Optional — for cloud image storage) ───────────
# If empty, images are saved locally under captures/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Alerting (Optional) ───────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── Email (SMTP) — Optional ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ── SMS (Twilio) — Optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=

# ── Logging ──────────────────────────────────────────────────
# Options: console (default), json
LOG_FORMAT=console

# ── Camera ──────────────────────────────────────────────────
# Use a mobile phone camera via RTSP (e.g. "IP Webcam" app on Android).
# Set this to your phone's RTSP URL, e.g.:
#   CAMERA_SOURCE=rtsp://192.168.1.10:554/stream
# Leave empty to use local webcam via CAMERA_INDEX (default 0).
CAMERA_SOURCE=http://10.151.42.241:8080/video
