# ============================================================
# .env.example — Surveillance System with Agentic AI
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to version control
# ============================================================

# ── MongoDB Atlas (REQUIRED) ──────────────────────────────────
# Get from: https://cloud.mongodb.com → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=surveillance
MONGODB_COLLECTION=faces
MONGODB_EVENTS_COLLECTION=events

# ── Cloudinary (Optional — for cloud image storage) ───────────
# Get from: https://cloudinary.com → Dashboard → API Environment Variable
# If empty, images are saved locally under captures/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── InsightFace Model ────────────────────────────────────────
# Options: buffalo_l (best quality), buffalo_m (balanced), buffalo_s (fastest)
INSIGHTFACE_MODEL=buffalo_m
INSIGHTFACE_DET_SIZE=1280
INSIGHTFACE_PROVIDER=CPUExecutionProvider

# ── YOLO Model ───────────────────────────────────────────────
# Options: yolov8n.pt (nano/fast), yolov8s.pt (small), yolov8m.pt (medium)
YOLO_MODEL=models/yolov8s.pt
YOLO_DEVICE=cpu

# ── Detection / Tracking ─────────────────────────────────────
PERSON_CONF_THRESHOLD=0.5
TRACK_TIMEOUT_SECS=8.0
MAX_TRACK_SECS=300
DET_SCORE_MIN=0.40
DET_SCORE_RELAXED=0.20
EMBEDDING_DET_SCORE_MIN=0.40

# ── Progressive Recognition ──────────────────────────────────
# Run face recognition every N frames (10 at 5fps = once per 2 seconds)
RECOGNITION_INTERVAL_FRAMES=10

# ── Quality Scoring ──────────────────────────────────────────
QUALITY_BLUR_MAX=1000
QUALITY_AREA_MAX=10000

# ── Face Matching ────────────────────────────────────────────
# Cosine similarity threshold (0.0 to 1.0, max 0.45)
# Higher = stricter matching (fewer false positives)
MATCH_THRESHOLD=0.30
DEDUP_SIMILARITY_THRESHOLD=0.40

# ── Mask Detection ───────────────────────────────────────────
MASK_DETECTION=heuristic
LOITER_SECS=30

# ── Face Visibility Classification ───────────────────────────
VISIBLE_FACE_RATIO=0.025
PARTIAL_FACE_RATIO=0.010
MIN_TRACK_FRAMES=30

# ── Office Hours (Policy Agent) ──────────────────────────────
# Persons detected outside these hours trigger alerts
OFFICE_HOURS_START=9
OFFICE_HOURS_END=17
# Days of week (0=Mon, 6=Sun, comma-separated)
OFFICE_DAYS=0,1,2,3,4

# ── Alerting ─────────────────────────────────────────────────
# Options: console, email, sms, webhook (comma-separated)
ALERT_CHANNELS=console
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECS=60

# ── Email (SMTP) — Optional ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ── SMS (Twilio) — Optional ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=

# ── Camera ───────────────────────────────────────────────────
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
CAMERA_ID=cam_01

# ── LLM (Ollama) — Optional ──────────────────────────────────
# Requires Ollama running locally with a model pulled
# Install: https://ollama.com | Pull: ollama pull gemma3:4b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=30

# ── Logging ──────────────────────────────────────────────────
# Options: console (default), json
LOG_FORMAT=console
